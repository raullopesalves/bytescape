{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "test",
      "type": "shell",
      "command": "cargo test",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "scan C:\\Windows",
      "type": "shell",
      "command": "cargo run --release -p bytescape-cli -- C:\\Windows",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "scan a folder",
      "type": "shell",
      "command": "cargo run --release -p bytescape-cli -- ${input:folder}",
      "problemMatcher": ["$rustc"]
    }
  ],
  "inputs": [
    { "id": "folder", "type": "promptString", "description": "Folder to scan", "default": "C:\\Users" }
  ]
}
