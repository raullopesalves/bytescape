{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bytescape",
  "version": "0.1.3",
  "identifier": "io.github.raullopesalves.bytescape",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Bytescape",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "publisher": "Raul Alves",
    "copyright": "Copyright (c) 2026 Raul Alves. MIT or Apache-2.0.",
    "category": "Utility",
    "shortDescription": "See what takes up space on your drives",
    "longDescription": "A disk usage analyzer for Windows: fast scans, a category-coloured treemap, search, scan history, a duplicate finder and a safe cleanup basket.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEREOTM4MjUwOTlFNERCMjMKUldRajIrU1pVSUtUM1FpOXdWOUZuWFpTUW56bUZESU5hTDdpRFVFUHlJOFh2cU1ZVDZCNGFtaFkK",
      "endpoints": [
        "https://github.com/raullopesalves/bytescape/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
